+"""Read-only seller data: calendar realization and order-cohort quantities."""
+import asyncio,csv,io,json,re,time,zipfile
+from collections import defaultdict
+from datetime import date,datetime
+from pathlib import PurePosixPath
+from urllib.parse import urlsplit,quote
+from zoneinfo import ZoneInfo
+import httpx
+from starlette.exceptions import HTTPException
+from . import podmasterye_yandex_market as ym
+from .web_access import check_dns
+
+SCHEMA=(
+"""CREATE TABLE IF NOT EXISTS pm_ym_order_snapshots(
+ cid TEXT NOT NULL REFERENCES pm_market_connections(id) ON DELETE CASCADE,
+ version INTEGER NOT NULL,campaign INTEGER NOT NULL,date_from TEXT NOT NULL,date_to TEXT NOT NULL,
+ collected INTEGER NOT NULL,data TEXT NOT NULL,PRIMARY KEY(cid,version,campaign,date_from,date_to))""",
+"""CREATE TABLE IF NOT EXISTS pm_ym_realization(
+ cid TEXT NOT NULL REFERENCES pm_market_connections(id) ON DELETE CASCADE,
+ version INTEGER NOT NULL,campaign INTEGER NOT NULL,month TEXT NOT NULL,
+ state TEXT NOT NULL,report_id TEXT,requested INTEGER NOT NULL,updated INTEGER NOT NULL,
+ data TEXT,error TEXT,PRIMARY KEY(cid,version,campaign,month))"""
+)
+def init(db):
+    for sql in SCHEMA:db.execute(sql)
+
+def today():return datetime.now(ZoneInfo("Europe/Moscow")).date()
+def month_value(m):
+    if not isinstance(m,str) or not re.fullmatch(r"\d{4}-\d{2}",m):raise ValueError("Укажите месяц в формате ГГГГ-ММ.")
+    a=date.fromisoformat(m+"-01")
+    if a>today() or a.year<2000:raise ValueError("Некорректный месяц.")
+    return a
+def dates(a,b):
+    if not all(isinstance(v,str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}",v) for v in (a,b)):raise ValueError("Укажите даты.")
+    a,b=date.fromisoformat(a),date.fromisoformat(b)
+    if a>b or (b-a).days>29 or b>today():raise ValueError("Выберите период до 30 дней, не в будущем.")
+    return a,b
+def positive(v,allow_zero=False):
+    if type(v) is not int or not (int(not allow_zero)<=v<=10**10):raise ValueError("Некорректное количество.")
+    return v
+def ident(v,allow_zero=False):
+    if type(v) is not int or not int(not allow_zero)<=v<2**63:raise ValueError("Некорректный идентификатор.")
+    return v
+def failure(status):
+    code={"denied":403,"rate_limited":429}.get(status,502)
+    raise HTTPException(code,{"denied":"Маркет отказал в доступе к данным.","rate_limited":"Лимит запросов Маркета. Повторите позже."}.get(status,"Маркет не подтвердил получение данных."))
+def clean(v,key,limit=200):
+    if not isinstance(v,str) or not v or len(v)>limit or not v.isprintable() or key in v:raise ValueError("Некорректные данные товара.")
+    return v
+def summary(rows,fields):
+    bysku={}
+    for r in rows:
+        x=bysku.setdefault(r["sku"],{"sku":r["sku"],"name":r["name"],**{k:0 for k in fields}})
+        for k in fields:x[k]+=r.get(k,0)
+    return {"totals":{k:sum(x[k] for x in bysku.values()) for k in fields},"products":sorted(bysku.values(),key=lambda x:x["sku"])}
+
+async def orders(client,f,shop,a,b,guard=lambda:None):
+    a,b=dates(a,b)
+    key=f["api_key"];campaign=shop["campaignId"];business=shop["businessId"]
+    payload={"campaignIds":[campaign],"dates":{"creationDateFrom":a.isoformat(),"creationDateTo":b.isoformat()},"fake":False}
+    path=f"/v1/businesses/{business}/orders";rows=[];seen=set();pages=set();page=None
+    statuses=defaultdict(int);skipped=0
+    unit_states={"CREATED","SHIPPED","CANCELLED","DELIVERED_TO_BUYER","LOST","REJECTED","RETURNED"}
+    order_states={"PLACING","RESERVED","UNPAID","PROCESSING","DELIVERY","PICKUP","DELIVERED","CANCELLED","PENDING","PARTIALLY_RETURNED","RETURNED","PARTIALLY_DELIVERED","UNKNOWN"}
+    for _ in range(100):
+        params={"limit":50}
