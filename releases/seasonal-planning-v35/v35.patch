+    wallet=OwnerV21.wallet
+    action=OwnerV21.action
+    def test_native_forecast_matches_api(self):
+        h,c=self.actor("buyer")
+        ids=self.c.post("/api/production/recipe",headers=h,json={"requestId":"seed","recipe":{"material":"Бусины","product":"Браслет","pack_quantity":100,"usage_quantity":4,"pack_price":"100"}}).json()
+        for rid,op,args in [
+            ("stock","opening",{"material":ids["material_id"],"quantity":500,"total":"500","day":"2025-05-01"}),
+            ("sale","sale",{"product":ids["product_id"],"quantity":100,"unit_price":"10","paid_amount":"1000","auto_produce":True,"day":"2025-05-02"})]:
+            r=self.c.post("/api/accounting/preview",headers=h,json={"operation":op,"arguments":args})
+            self.assertEqual(r.status_code,200,r.text);a=r.json()
+            r=self.c.post("/api/accounting/commit",headers=h,json={"requestId":rid,"operation":op,"arguments":a["arguments"],"revision":a["revision"]})
+            self.assertEqual(r.status_code,200,r.text)
+        sources=self.action(h,c,"sources","mcp__platform__seasonal_sources",{})
+        self.assertIn("ledger",sources["text"])
+        args={"source":"ledger","history_from":"2025-05","history_to":"2025-05","target_from":"2027-05"}
+        api=self.c.post("/api/accounting/seasonal/plan",headers=h,json=args)
+        self.assertEqual(api.status_code,200,api.text)
+        self.assertEqual(api.json()["totals"][0]["buyQuantity"],300)
+        r=self.action(h,c,"forecast","mcp__platform__material_forecast",{**args,"detail_month":"2027-05"})
+        self.assertIn("buyQuantity",r["text"]);self.assertIn("300",r["text"])
+        self.assertIn("forecastSales",r["text"]);self.assertIn("monthDetail",r["text"])
+        self.assertNotIn("Tool execution failed",r["text"])
+        self.assertEqual(self.c.get("/api/accounting",headers=h).json()["materials"][0]["quantity"],100)
