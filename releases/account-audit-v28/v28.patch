+// Display only. Round the server's exact decimal coin string to hundredths
+// without converting its twelve fractional digits to binary floating point.
+const coinAmount=new Intl.NumberFormat('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2});
+function formatCoins(value){
+  const raw=String(value??'');
+  if(!/^\d{1,7}(?:\.\d{1,12})?$/.test(raw))return '—';
+  const [whole,fraction='']=raw.split('.');
+  const digits=fraction.padEnd(3,'0');
+  const cents=BigInt(whole)*100n+BigInt(digits.slice(0,2))+(digits[2]>='5'?1n:0n);
+  return coinAmount.format(Number(cents)/100);
+}
