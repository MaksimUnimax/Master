+"""Only display is rounded; exact ledger and API amounts survive."""
+from decimal import Decimal, ROUND_HALF_UP
+from playwright.sync_api import expect
+from test_podmasterye_independent_ui import IndependentUI
+
+class BalanceV28UI(IndependentUI):
+    def test_balance_rounding_preserves_exact_ledger(self):
+        identity=self.app.state.identity
+        identity.grant_coins(self.login,"9.54317045032","balance-fixture-v28","Local browser fixture")
+        self.sign_in()
+        p=self.page
+        raw=p.request.get("/api/wallet").json()["available"]
+        self.assertEqual(Decimal(raw)%1,Decimal("0.54317045032"))
+        shown=format(Decimal(raw).quantize(Decimal("0.01"),rounding=ROUND_HALF_UP),"f").replace(".",",")
+        expect(p.locator("#balance-label")).to_have_text("Баланс: "+shown+" монет")
+        p.locator('[data-page="wallet"]').click()
+        expect(p.locator("#wallet-info")).to_contain_text("Доступно "+shown)
+        self.assertEqual(p.request.get("/api/wallet/balance").json()["available"],raw)
+        p.reload()
+        expect(p.locator("#balance-label")).to_have_text("Баланс: "+shown+" монет")
+        self.assertEqual(p.request.get("/api/wallet").json()["available"],raw)
