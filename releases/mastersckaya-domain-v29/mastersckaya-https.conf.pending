server {
    listen 80;
    listen [::]:80;
    server_name mastersckaya.ru www.mastersckaya.ru;
    location ^~ /.well-known/acme-challenge/ { root /var/www/podmasterye-acme; default_type text/plain; try_files $uri =404; }
    location / { return 308 https://mastersckaya.ru$request_uri; }
}
server {
    listen 443 ssl;
    server_name www.mastersckaya.ru;
    ssl_certificate /etc/letsencrypt/live/mastersckaya/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mastersckaya/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Robots-Tag "noindex, nofollow" always;
    return 308 https://mastersckaya.ru$request_uri;
}
server {
    listen 443 ssl;
    server_name mastersckaya.ru;
    ssl_certificate /etc/letsencrypt/live/mastersckaya/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mastersckaya/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header X-Robots-Tag "noindex, nofollow" always;
    access_log off;
    client_max_body_size 800k;
    location / {
        location = /api/session/uploadFileBinary {
            client_max_body_size 8m;
            proxy_pass http://127.0.0.1:18971;
        }
        proxy_pass http://127.0.0.1:18971;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 180s;
        location ~ "^/api/chats/[^/]+/files/[a-f0-9]{32}/process/[^/]+$" {
            proxy_pass http://127.0.0.1:18971;
            proxy_read_timeout 900s;
        }
    }
}
