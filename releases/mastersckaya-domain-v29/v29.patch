+"""Domain migration acceptance: public identity and secure scoped routes, no live providers."""
+import os,sys,subprocess
+from unittest.mock import patch
+from tests.test_podmasterye_public_v22 import PublicV22
+from platform_core import site_identity,public_faq
+from platform_core import guest_selector
+class DomainV29(PublicV22):
+    def test_new_origin_contract(self):
+        with patch.dict(os.environ,{"PODMASTERYE_PUBLIC_ORIGIN":"https://mastersckaya.ru","PODMASTERYE_INDEX_PUBLIC":"0"}):
+            for path in ("/","/about/","/kalkulyator","/kalkulyator-pribyli/","/payment","/support","/contacts","/login","/register"):
+                r=self.c.get(path);self.assertEqual(r.status_code,200,path)
+                self.assertIn("· Мастерская</title>",r.text)
+                self.assertIn('rel="canonical" href="https://mastersckaya.ru/',r.text)
+                self.assertIn('aria-label="Мастерская"',r.text)
+                self.assertNotIn("sslip.io",r.text)
+                self.assertIn("noindex",r.headers["X-Robots-Tag"])
+            self.assertIn("Мастерская — программа учёта",self.c.get("/about/").text)
+            self.assertIn("агент «Подмастерье»",self.c.get("/about/").text)
+            self.assertIn("https://mastersckaya.ru/kalkulyator</loc>",self.c.get("/sitemap.xml").text)
+        for v in ("http://mastersckaya.ru","https://mastersckaya.ru/other","https://mastersckaya.ru@evil.example","https://mastersckaya.ru?x=1","https://mastersckaya.ru:444"):
+            with patch.dict(os.environ,{"PODMASTERYE_PUBLIC_ORIGIN":v}):
+                self.assertEqual(site_identity.public_origin(),"")
+                with self.assertRaises(ValueError):site_identity.integration_origin()
+        env=dict(os.environ,PODMASTERYE_PUBLIC_ORIGIN="https://mastersckaya.ru")
+        p=subprocess.run([sys.executable,"-c","from platform_core import telegram_api as t,metrika_report as m,podmasterye_visits as v; assert t.CALLBACK=='https://mastersckaya.ru/telegram/return'; assert m.DOMAIN==v.DOMAIN=='mastersckaya.ru'; assert 'mastersckaya.ru' in m.PAGE_FILTER; assert 'sslip.io' not in m.PAGE_FILTER"],env=env,capture_output=True,text=True)
+        self.assertEqual(p.returncode,0,p.stderr)
+    def test_existing_guest_and_member_contracts(self):
+        h={"Origin":"https://master.example","Accept":"application/json"}
+        with patch.object(guest_selector,"classify",side_effect=AssertionError("unexpected paid call")):
+            chat=self.c.post("/guest/session",headers=h).json()["chat"]
+            r=self.c.post("/guest/chats/"+chat+"/turns?state=1",headers=h,data={"request_id":"domain-guest","text":"Что ты умеешь?"})
