+"""Product identity and canonical external origin. Internal IDs stay stable."""
+import os,re
+from urllib.parse import urlsplit
+SERVICE_NAME = "Мастерская"
+AGENT_NAME = "Подмастерье"
+# Only the old deployment's compatibility default; never a production domain.
+LEGACY_STAGE_ORIGIN = "https://podmasterye.185-219-43-9.sslip.io"
+
+def public_origin():
+    raw=os.getenv("PODMASTERYE_PUBLIC_ORIGIN","").rstrip("/")
+    try:
+        u=urlsplit(raw)
+        if (u.scheme=="https" and u.hostname and u.netloc==u.hostname
+            and re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?",u.hostname)
+            and not (u.path or u.query or u.fragment or u.username or u.password)):
+            return raw
+    except ValueError:
+        pass
+    return ""
+
+def integration_origin():
+    configured=os.getenv("PODMASTERYE_PUBLIC_ORIGIN","")
+    if not configured:
+        return LEGACY_STAGE_ORIGIN
+    origin=public_origin()
+    if not origin:
+        raise ValueError("Invalid configured public HTTPS origin")
+    return origin
+
+def integration_domain():
+    return urlsplit(integration_origin()).hostname
