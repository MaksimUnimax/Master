+"""Read-only Yandex Market connection discovery, isolated from Octoport."""
+import httpx
+
+PROVIDER={"title":"Яндекс Маркет","fields":{"api_key":"API-ключ Яндекс Маркета"}}
+ORIGIN="https://api.partner.market.yandex.ru"
+SCOPES=frozenset(("ALL_METHODS","ALL_METHODS_READ_ONLY","INVENTORY_AND_ORDER_PROCESSING",
+    "INVENTORY_AND_ORDER_PROCESSING_READ_ONLY","PRICING","PRICING_READ_ONLY",
+    "OFFERS_AND_CARDS_MANAGEMENT","OFFERS_AND_CARDS_MANAGEMENT_READ_ONLY",
+    "PROMOTION","PROMOTION_READ_ONLY","FINANCE_AND_ACCOUNTING","COMMUNICATION",
+    "SETTINGS_MANAGEMENT","SUPPLIES_MANAGEMENT_READ_ONLY"))
+MAX_PAGES=100
+
+def credentials(fields):
+    if not isinstance(fields,dict) or set(fields)!={"api_key"}:
+        raise ValueError("Укажите API-ключ Яндекс Маркета.")
+    value=fields["api_key"]
+    if not isinstance(value,str) or not 1<=len(value.strip())<=8192 or not value.isascii() or not value.isprintable() or any(c.isspace() for c in value.strip()):
+        raise ValueError("Некорректный API-ключ Яндекс Маркета.")
+    return {"api_key":value.strip()}
+
+async def call(client,method,path,key,**kw):
+    try:
+        r=await client.request(method,ORIGIN+path,headers={"Api-Key":key,"Accept":"application/json"},timeout=10,follow_redirects=False,**kw)
+        if r.status_code in (401,403):return "denied",None
+        if r.status_code==429:return "rate_limited",None
+        if not r.is_success:return "unconfirmed",None
+        d=r.json()
+        if not isinstance(d,dict) or d.get("status") not in (None,"OK"):return "unconfirmed",None
+        return "verified",d
+    except (httpx.HTTPError,ValueError,TypeError):
+        return "unconfirmed",None
+
+def label(v,key):
+    # Only the documented non-secret metadata is stored. Do not reflect a
+    # credential even if a malformed provider response echoes it.
+    if not isinstance(v,str) or key in v:return ""
+    return "".join(c for c in v if c.isprintable())[:200]
+
+async def probe(client,f):
+    key=f["api_key"]
+    checks={"Токен":"unconfirmed","Список магазинов":"unconfirmed"}
+    details={"scopes":[],"campaigns":[],"complete":False}
+    status,d=await call(client,"POST","/v2/auth/token",key)
+    checks["Токен"]=status
+    if status!="verified":return checks,details
+    try:
+        scopes=d["result"]["apiKey"]["authScopes"]
+        if not isinstance(scopes,list) or not scopes or not all(isinstance(x,str) for x in scopes):raise ValueError()
+        details["scopes"]=sorted(set(scopes)&SCOPES)
+    except (KeyError,TypeError,ValueError):
+        checks["Токен"]="unconfirmed";return checks,details
+    page=None;seen=set();rows={}
+    for _ in range(MAX_PAGES):
+        params={"limit":100}
+        if page is not None:params["pageToken"]=page
+        status,d=await call(client,"GET","/v2/campaigns",key,params=params)
+        if status!="verified":
+            checks["Список магазинов"]=status
+            return checks,details
+        try:
+            campaigns=d["campaigns"]
+            if not isinstance(campaigns,list) or len(campaigns)>100:raise ValueError()
+            for c in campaigns:
+                cid=c["id"];bid=c["business"]["id"]
+                if type(cid) is not int or cid<1 or type(bid) is not int or bid<1 or cid in rows:raise ValueError()
+                rows[cid]={"campaignId":cid,"businessId":bid,"name":label(c.get("domain"),key),
+                    "businessName":label(c["business"].get("name"),key),
+                    "placementType":c.get("placementType") if c.get("placementType") in ("FBS","FBY","DBS","LAAS") else "",
+                    "apiAvailability":c.get("apiAvailability") if c.get("apiAvailability") in ("AVAILABLE","DISABLED_BY_INACTIVITY","DISABLED_BY_NO_ACTIVE_CONTRACT","MANUALLY_DISABLED","DISABLED_BY_NO_PLACEMENT_TYPE") else ""}
+            paging=d.get("paging") or {}
+            if not isinstance(paging,dict):raise ValueError()
+            page=paging.get("nextPageToken")
+            if page is None or page=="":
+                details.update(campaigns=list(rows.values()),complete=True)
+                checks["Список магазинов"]="verified"
+                return checks,details
+            if not isinstance(page,str) or len(page)>8192 or page in seen:raise ValueError()
+            seen.add(page)
+        except (KeyError,TypeError,AttributeError,ValueError):
+            checks["Список магазинов"]="incomplete";return checks,details
+    checks["Список магазинов"]="incomplete"
+    return checks,details
