+SAFE={"material","product","recipe_line","task","task_state","worker","cost_policy","channel_rates","opening","purchase","manufacture","work_start","work_finish","component_transfer","sale","payment","sale_fee","expense","worker_payment","asset_acquire"}
+def safe(proposal):
+    c=proposal["confirmation"]
