+def init(db):
+    db.execute("""CREATE TABLE IF NOT EXISTS pm_write_preferences(
+      workspace TEXT PRIMARY KEY REFERENCES workspaces(workspace_id) ON DELETE CASCADE,
+      ask INTEGER NOT NULL CHECK(ask IN(0,1)), version INTEGER NOT NULL)""")
+    db.execute("""CREATE TABLE IF NOT EXISTS pm_write_intents(
+      workspace TEXT NOT NULL,chat TEXT NOT NULL,rid TEXT NOT NULL,
+      mode TEXT NOT NULL CHECK(mode IN('confirm','explicit','automatic')),
+      version INTEGER NOT NULL,requires_web INTEGER NOT NULL CHECK(requires_web IN(0,1)),
+      PRIMARY KEY(workspace,chat,rid),
+      FOREIGN KEY(workspace,chat,rid) REFERENCES pm_turns(workspace,chat,rid) ON DELETE CASCADE)""")
+
+def preference(db,w):
+    row=db.execute("SELECT ask,version FROM pm_write_preferences WHERE workspace=?",(w,)).fetchone()
+    return (bool(row[0]),row[1]) if row else (True,0)
+
+def get(store,token,requested):
+    with store._lock:
+        _,a=_principal(store._db,token);w=workshops.resolve(store._db,a,requested)
+        ask,version=preference(store._db,w)
+        return {"askConfirmation":ask,"version":version}
+
+def update(store,token,requested,ask,version):
+    if type(ask) is not bool or type(version) is not int or version<0:raise ValueError("Некорректные настройки подтверждения.")
+    with store._write() as db:
+        _,a=_principal(db,token);w=workshops.resolve(db,a,requested)
+        old,v=preference(db,w)
+        if v!=version:raise domain.Conflict("Настройки изменились. Обновите страницу.")
+        if old!=ask:
+            v+=1
+            db.execute("INSERT INTO pm_write_preferences VALUES(?,?,?) ON CONFLICT(workspace) DO UPDATE SET ask=excluded.ask,version=excluded.version",(w,int(ask),v))
+        return {"askConfirmation":ask,"version":v}
+
+# Only direct imperative clauses authorize an automatic business write. Ignore
+# quoted examples, questions, conditional or negated instructions.
+NEGATIVE=re.compile(r'\b(?:не\s+(?:сохрани\w*|сохраня\w*|запиши\w*|записыва\w*|созда\w*|добав\w*|внес\w*|измени\w*|обнов\w*|оформи\w*|проведи\w*|учитыва\w*)|без\s+сохранения|только\s+черновик|если|например|допустим|представь|как\s+(?:сохранить|создать|добавить|изменить)|можно\s+ли)\b',re.I)
