+ "work_finish":r"заверш.{0,15}производств|нзп",
+ "component_transfer":r"полуфабрикат",
+ "sale":r"продаж|продан|продал",
+ "payment":r"оплат|плат[её]ж|поступлени.{0,15}денег",
+ "sale_fee":r"удержан|комисси|эквайринг",
+ "expense":r"расход|затрат",
+ "worker_payment":r"выплат|зарплат",
+ "asset_acquire":r"оборудован|актив|амортизаци",
