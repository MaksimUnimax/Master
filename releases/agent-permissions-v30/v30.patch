+PREFIX=r'(?:(?:да|пожалуйста|сам|сама|самостоятельно)[,\s]+)*'
+EXPLICIT=re.compile(START+PREFIX+r'(?:сохрани(?:те)?|сохраняй(?:те)?|запиши(?:те)?|проведи(?:те)?)\b',re.I)
+ACTION=re.compile(START+PREFIX+r'(?:сохрани(?:те)?|сохраняй(?:те)?|запиши(?:те)?|создай(?:те)?|добавь(?:те)?|внеси(?:те)?|измени(?:те)?|обнови(?:те)?|оформи(?:те)?|проведи(?:те)?)\b',re.I)
+QUOTED=re.compile(r'«[^»]*»|"(?:[^"\\]|\\.)*"|\x60[^\x60]*\x60',re.S)
+
+# A file/document instruction must not confer permission to change the ledger.
+TARGETS={
+ "recipe":r"рецепт|рецептур|издели|упаковк|расход.{0,24}издел|пачк",
+ "material":r"материал|сырь[ея]|упаковк|пачк|цен[ау].{0,20}(?:материал|сырь|упаковк)",
+ "product":r"издели|продукт|товар",
+ "recipe_line":r"рецепт|рецептур|расход.{0,24}издел",
