+        JOIN usage_operations o USING(operation_id) JOIN coin_attempts a ON a.attempt_id=w.attempt_id
+        JOIN web_attempt_state s ON s.attempt_id=a.attempt_id
+        WHERE o.workspace_id=? AND o.chat_id=? AND o.actor_id=? AND o.run_key=? AND o.source='chat.turn'
