@@ -13,0 +14,19 @@
+# Single authoritative input-format catalog, shared by upload validation and UI.
+def format_groups():
+    groups = {
+        "Таблицы": {"xlsx","xlsm","xls","ods","csv","tsv"},
+        "Документы": {"docx","doc","odt","pdf","rtf"},
+        "Презентации": {"pptx","ppt"},
+        "Изображения": set(RASTER) | {"svg"},
+        "Аудио": set(AUDIO),
+        "Архивы": {"zip"},
+        "Текст и данные": {"txt","json","xml","md","yaml","yml","log","html","htm","ini","toml"},
+        "Исходный код": TEXT - {"txt","csv","tsv","json","xml","md","yaml","yml","log","ini","toml"},
+    }
+    supported=TEXT | set(OFFICE) | set(ODF) | set(RASTER) | AUDIO | {"doc","xls","ppt","svg","pdf","zip","html","htm","rtf"}
+    assert set().union(*groups.values()) == supported
+    return {label: sorted(values) for label,values in groups.items()}
+
+def supported_extensions():
+    return sorted(set().union(*format_groups().values()))
+
