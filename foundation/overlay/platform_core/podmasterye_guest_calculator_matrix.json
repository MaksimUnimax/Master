[
  {
    "id": "cost-open",
    "panel": "calculator",
    "action": "open",
    "patterns": [
      "(?:(?:открой(?:те)?|покажи(?:те)?|запусти(?:те)?) (?:мне )?)?калькулятор(?: себестоимости(?: изделия| продукции)?)?"
    ],
    "example": "Открой калькулятор себестоимости",
    "reply": "Открываю бесплатный калькулятор себестоимости справа. Укажите изделие, материалы, цену продажи и труд. Расчёты выполняются без ИИ и монет."
  },
  {
    "id": "cost-help",
    "panel": "calculator",
    "action": "help",
    "patterns": [
      "как (?:пользоваться|работать с|заполнить) калькулятор(?:ом)?(?: себестоимости)?",
      "как (?:рассчитать|посчитать) себестоимость(?: изделия| продукции)?",
      "инструкция по калькулятору(?: себестоимости)?"
    ],
    "example": "Как пользоваться калькулятором",
    "reply": "Открою инструкцию. 1. Назовите изделие. 2. Добавьте материалы: количество в упаковке, цену всей упаковки и расход на изделие в одной единице измерения. 3. Укажите цену продажи, минуты работы и стоимость часа. 4. Нажмите «Рассчитать». После регистрации можно сохранить изделие и рецептуру, вести закупки, склад и продажи."
  },
  {
    "id": "product",
    "panel": "calculator",
    "action": "set",
    "field": "product_name",
    "patterns": [
      "(?:название изделия|изделие|назови изделие)\\s*[:=]\\s*(?P<value>[^;\\r\\n]{1,120})"
